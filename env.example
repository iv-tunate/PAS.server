APP_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pas?sslmode=disable

# At least 32 random characters. Signs every admin session.
JWT_SECRET=

# The website (used for CORS and links in emails) and this API's public
# address (the download links in emails point here).
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080

# Set to true ONLY when the API runs behind a reverse proxy / platform load
# balancer. It lets rate limits see each visitor's real address.
TRUST_PROXY=false

# Payments. Leave a gateway's key empty to switch it off. Paystack and
# Flutterwave charge in naira, Stripe in dollars.
# Webhook URLs to give each provider: {API_PUBLIC_URL}/api/v1/payments/webhook/paystack
# (or /flutterwave, /stripe)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Brevo). Downloads, contact notifications and newsletters all go out
# through this. The sender address must be verified in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Akintola Samuel
# Optional: also mirror new subscribers into a Brevo contact list.
# BREVO_LIST_ID=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
